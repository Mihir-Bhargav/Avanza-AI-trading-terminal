# Avanza — unofficial API, read-only use.
# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#
#   cp .env.example .env
#
# Get AVANZA_TOTP_SECRET from:
#   Profil > Inställningar > Sajtinställningar > Inloggning och utloggning
#     > Användarnamn > Tvåfaktorsinloggning
#   -> Aktivera (or Återaktivera) -> "Annan app för tvåfaktorsinloggning"
#   -> "Kan du inte scanna QR-koden?"        reveals the long base32 string
#
# Avanza then asks you to prove the secret works. Generate the code with:
#   python3.13 -m terminal.avanza_setup
# and paste it back into that same activation screen. Skip this and the secret
# never activates -- and it fails later at login, looking like a bad password.

AVANZA_USERNAME=
AVANZA_PASSWORD=
AVANZA_TOTP_SECRET=

# Optional — push alerts (level breaks, news bot). Any unguessable string;
# subscribe to the same topic in the ntfy app. No account needed.
NTFY_TOPIC=

# Optional — /api/disclosures?type=congress (STOCK Act congress trades).
# Free key: https://www.alphavantage.co/support/#api-key (~25 requests/day;
# responses are cached per day under data/cache/alphavantage/).
ALPHAVANTAGE_API_KEY=

# Optional — /api/insiders (live SEC Form 4 insider trades) and
# /api/disclosures?type=funds (13F moves of well-known funds). Free, no key.
# The SEC requires automated readers to identify themselves: a name and a
# contact email, e.g. SEC_USER_AGENT="Range Terminal you@example.com".
SEC_USER_AGENT=
